---
interface Props {
  categoryId: string;
  headline: string;
  description: string;
  source: string;
  faviconChar: string;
  faviconColor: string;
  date: string;
  readMin: number;
  isUiUpdate?: boolean;
  url: string;
}

const {
  categoryId,
  headline,
  description,
  source,
  faviconChar,
  faviconColor,
  date,
  readMin,
  isUiUpdate = false,
  url,
} = Astro.props;
---
<a class="card" data-cat={categoryId} href={url} target="_blank" rel="noopener noreferrer">
  {isUiUpdate && (
    <span class="ui-badge">📱 UI-изменение</span>
  )}
  <h3 class="card-headline">{headline}</h3>
  <p class="card-desc">{description}</p>
  <div class="source-row">
    <span
      class="favicon"
      style={`background: ${faviconColor}`}
      aria-hidden="true"
    >{faviconChar}</span>
    <span class="src">{source}</span>
    <span class="sep">·</span>
    <span>{date}</span>
    <span class="sep">·</span>
    <span>{readMin} мин</span>
  </div>
</a>
